# Independent, non-production NASERI MARKETS package and image.
# Historical Dockerfile.production and source manifest remain untouched.
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS wheel_builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /build
COPY platform_release/pyproject.toml ./pyproject.toml
COPY platform_release/README.md ./README.md
COPY naseri_markets ./naseri_markets
RUN python -m pip wheel --disable-pip-version-check --no-deps --wheel-dir /wheels .

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
LABEL org.opencontainers.image.title="NASERI MARKETS (OFFLINE PREVIEW)" \
      org.opencontainers.image.version="0.4.0rc1" \
      org.opencontainers.image.source="https://github.com/naseri-coder/Multi-Market-Trading"
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN addgroup --gid 10001 markets \
    && adduser --disabled-password --gecos "" --uid 10001 \
       --ingroup markets --home /nonexistent --shell /usr/sbin/nologin markets
COPY --from=wheel_builder /wheels/multi_market_trading-0.4.0rc1-py3-none-any.whl /tmp/
RUN python -m pip install --root-user-action=ignore --no-deps \
      /tmp/multi_market_trading-0.4.0rc1-py3-none-any.whl \
    && rm /tmp/multi_market_trading-0.4.0rc1-py3-none-any.whl \
    && python -m naseri_markets --check
USER 10001:10001
WORKDIR /nonexistent
ENTRYPOINT ["python", "-m", "naseri_markets"]
CMD ["--check"]
