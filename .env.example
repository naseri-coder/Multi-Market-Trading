# Safe v0.3.0 fresh-host template. Never commit a populated .env.
APP_NAME=crypto-price-action
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

TELEGRAM_RUNTIME_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=10
TELEGRAM_DROP_PENDING_UPDATES=false
ADMIN_IDS=REPLACE_WITH_NUMERIC_ADMIN_ID
REPORT_TIMEZONE=Asia/Tehran
BROADCAST_RATE_PER_SECOND=20
BROADCAST_BATCH_SIZE=250
BROADCAST_MAX_RETRIES=2
BROADCAST_RETRY_AFTER_CAP_SECONDS=60

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_USER=crypto_bot
POSTGRES_PASSWORD=REPLACE_WITH_NEW_RANDOM_URLSAFE_PASSWORD
POSTGRES_DB=crypto_bot
DATABASE_URL=postgresql+asyncpg://crypto_bot:REPLACE_WITH_NEW_RANDOM_URLSAFE_PASSWORD@postgres:5432/crypto_bot

PAPER_RUNTIME_ENABLED=false
PAPER_DEFAULT_LEVERAGE=1
PAPER_POLL_INTERVAL_SECONDS=60

PERFORMANCE_INTELLIGENCE_SHADOW_MODE=false
PERFORMANCE_REPORTS_ENABLED=false
PERFORMANCE_REPORT_PARSE_MODE=HTML
PERFORMANCE_REPORT_TIMEZONE=UTC
PERFORMANCE_REPORT_MAX_RETRY=3
PERFORMANCE_REPORT_INTERVAL=3600

BROOKS_RUNTIME_ENABLED=false
BROOKS_RUNTIME_MODE=paper
BROOKS_EXCHANGE=binance
BROOKS_MARKET_TYPE=futures
BROOKS_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,SOLUSDT
BROOKS_TIMEFRAMES=15m,1h
BROOKS_SNAPSHOT_LIMIT=120
BROOKS_POLL_INTERVAL_SECONDS=60
BROOKS_LIVE_LEVERAGE=1
BROOKS_HISTORICAL_PROBABILITY_DOMAIN=FUTURES_ONLY
BROOKS_SCALE_IN_MODE=disabled

BROOKS_OPERATIONS_ENABLED=false
SIGNAL_LIFECYCLE_POLL_INTERVAL_SECONDS=30
SIGNAL_LIFECYCLE_CANDLE_LIMIT=240
PAYMENT_SETTLEMENT_POLL_INTERVAL_SECONDS=60
VIP_ENTITLEMENT_POLL_INTERVAL_SECONDS=300
VIP_INVITE_TTL_HOURS=24

# Conditional settings. Uncomment only when the related mode is intentionally enabled.
# PAPER_PRIVATE_TEST_CHANNEL_ID=-1001234567890
# PERFORMANCE_REPORT_CHANNEL_ID=-1001234567890
# BROOKS_VIP_CHANNEL_ID=-1001234567890
# BROOKS_LIVE_CUTOVER_AT=2026-10-03T00:00:00+00:00
# BROOKS_OPS_CUTOVER_AT=2026-10-03T00:00:00+00:00
